// Designer Canvas -> Published Template data model.
// See /root/.claude/plans/designer-canvas-published-imperative-bird.md for the full architecture rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  DESIGNER
  CONSULTANT
  // Extension point -- not wired to any route yet. No background job/cron/
  // service-to-service caller exists in this app today; this exists so the
  // enum doesn't need a breaking change when one does.
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  sessions Session[]
  projects Project[]
}

// DB-backed opaque session, not a JWT -- matches this app's "Postgres is the
// system of record" philosophy and gives instant revocation (delete the row)
// with no signing-secret rotation story.
model Session {
  id        String   @id @default(cuid())
  // Random 256-bit token, distinct from id -- id is a cuid (optimized for
  // uniqueness, not brute-force resistance); token is generated via
  // node:crypto specifically for its unpredictability as a bearer credential.
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Template / Design Library
// ---------------------------------------------------------------------------

enum DesignStatus {
  DRAFT
  PUBLISHED
}

// Library browsing/merchandising taxonomy -- presentation metadata for the
// Design Library grid, distinct from the design graph. Editable even after
// a Template is published, since "published templates are immutable" is
// about the geometry/product graph, not how a template is displayed.
enum LibraryRoomType {
  LIVING_ROOM
  TV_UNIT
  BEDROOM
}

model Look {
  id          String @id @default(cuid())
  key         String @unique
  label       String
  swatchColor String // hex color placeholder swatch -- no real material photography yet

  designs Design[]
}

model Design {
  id               String       @id @default(cuid())
  name             String
  description      String?
  tags             String[]     @default([])
  thumbnailUrl     String?
  version          Int          @default(1)
  status           DesignStatus @default(DRAFT)
  rootTemplateId   String?
  parentTemplateId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  publishedAt      DateTime?

  libraryRoomType LibraryRoomType?
  lookId          String?
  look            Look?            @relation(fields: [lookId], references: [id])
  pricePerSqFt    Float?
  areaSqFt        Float?
  isFavorited     Boolean          @default(false)

  geometryNodes                GeometryNode[]
  geometryEdges                GeometryEdge[]
  geometryEdgeRelationships    GeometryEdgeRelationship[]
  productInstances             ProductInstance[]
  productInstanceEdges         ProductInstanceEdge[]
  geometryProductRelationships GeometryProductRelationship[]
  templateParameters           TemplateParameter[]
  validationResults            DesignValidationResult[]
  masterBoms                   MasterBom[]
  projects                     Project[]
  fixtures                     Fixture[]
  wallJunctions                WallJunction[]
  constraints                  Constraint[]

  @@index([rootTemplateId])
  @@index([status])
  @@index([lookId])
}

model DesignValidationResult {
  id       String   @id @default(cuid())
  designId String
  design   Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  ranAt    DateTime @default(now())
  passed   Boolean
  issues   Json[]   @default([])

  @@index([designId, ranAt])
}

// ---------------------------------------------------------------------------
// Geometry graph
// ---------------------------------------------------------------------------

enum GeometryNodeType {
  WALL
  ZONE
  PARTITION
  PANEL
  PRIMITIVE
}

// RECTANGLE is a standalone shape primitive -- NOT an alias for or
// replacement of WallSegment/Zone/ZonePartition/Panel, which carry real
// domain semantics (containment FKs, orderIndex, coverage validation) that
// a generic shape deliberately does not have. See Phase 6 item 1's Key
// design decisions in the plan file.
enum GeometryPrimitiveKind {
  RECTANGLE
  LINE
  POLYLINE
  ARC
  CIRCLE
}

model GeometryNode {
  id            String                 @id @default(cuid())
  designId      String
  design        Design                 @relation(fields: [designId], references: [id], onDelete: Cascade)
  nodeType      GeometryNodeType
  // Non-null iff nodeType === PRIMITIVE; null for WALL/ZONE/PARTITION/PANEL
  // forever.
  primitiveKind GeometryPrimitiveKind?
  label         String?

  wallSegment                         WallSegment?
  zone                                Zone?
  partition                           ZonePartition?
  panel                               Panel?
  primitiveRectangle                  GeometryPrimitiveRectangle?
  primitiveLine                       GeometryPrimitiveLine?
  primitivePolyline                   GeometryPrimitivePolyline?
  primitiveArc                        GeometryPrimitiveArc?
  primitiveCircle                     GeometryPrimitiveCircle?
  edges                               GeometryEdge[]
  productInstances                    ProductInstance[]
  geometryProductRelationships        GeometryProductRelationship[]
  projectProductInstances             ProjectProductInstance[]
  projectGeometryProductRelationships ProjectGeometryProductRelationship[]
  constraintTargetsA                  Constraint[]                         @relation("ConstraintTargetANode")
  constraintTargetsB                  Constraint[]                         @relation("ConstraintTargetBNode")

  @@index([designId, nodeType])
  @@index([designId, primitiveKind])
}

// Standalone axis-aligned rectangle. Schema-only this pass -- no domain
// function, API route, or renderer exists yet; a future feature (e.g. an
// Installation Area boundary) builds those when it needs a rectangular
// boundary that is NOT a Wall/Zone/Partition/Panel's containment-tree
// member.
model GeometryPrimitiveRectangle {
  id          String       @id
  node        GeometryNode @relation(fields: [id], references: [id], onDelete: Cascade)
  designId    String
  xMm         Float
  yMm         Float
  widthMm     Float
  heightMm    Float
  rotationDeg Float        @default(0)
}

// The one primitive kind with a full domain-function/API/rendering
// build-out this pass. Fixed 2-endpoint cardinality stored as 4 inline
// columns (no child table needed, unlike POLYLINE's N points).
model GeometryPrimitiveLine {
  id       String       @id
  node     GeometryNode @relation(fields: [id], references: [id], onDelete: Cascade)
  designId String
  startXMm Float
  startYMm Float
  endXMm   Float
  endYMm   Float
}

// Schema-only this pass. `closed` distinguishes an open polyline (a path)
// from a closed one (a boundary/polygon) -- a future Installation Area
// pass would likely set closed=true.
model GeometryPrimitivePolyline {
  id       String                           @id
  node     GeometryNode                     @relation(fields: [id], references: [id], onDelete: Cascade)
  designId String
  closed   Boolean                          @default(false)
  points   GeometryPrimitivePolylinePoint[]
}

// Ordered via a real sequenceIndex column, matching this app's existing
// ZonePartition/Panel orderIndex precedent over a JSON point array -- gives
// per-point referential integrity and queryability a JSON array would
// lose. `bulge` is the DXF-convention bulge factor: 0 = straight segment to
// the next point (by sequenceIndex), nonzero = a circular-arc bulge between
// this point and the next, letting one polyline mix straight and curved
// segments without a second table.
model GeometryPrimitivePolylinePoint {
  id            String                    @id @default(cuid())
  polylineId    String
  polyline      GeometryPrimitivePolyline @relation(fields: [polylineId], references: [id], onDelete: Cascade)
  sequenceIndex Int
  xMm           Float
  yMm           Float
  bulge         Float                     @default(0)

  @@unique([polylineId, sequenceIndex])
}

// Schema-only this pass. sweepAngleDeg is signed (positive = clockwise in
// screen space) to match Konva's own Arc `angle` convention directly, so a
// future renderer needs no runtime conversion.
model GeometryPrimitiveArc {
  id            String       @id
  node          GeometryNode @relation(fields: [id], references: [id], onDelete: Cascade)
  designId      String
  centerXMm     Float
  centerYMm     Float
  radiusMm      Float
  startAngleDeg Float
  sweepAngleDeg Float
}

// Schema-only this pass. Deliberately its own table, not an ARC with
// sweepAngleDeg=360 -- avoids nullable/meaningless angle columns on a shape
// that has no start/end.
model GeometryPrimitiveCircle {
  id        String       @id
  node      GeometryNode @relation(fields: [id], references: [id], onDelete: Cascade)
  designId  String
  centerXMm Float
  centerYMm Float
  radiusMm  Float
}

// Renamed from `Wall` (WallType enum + cornerAngleDeg removed -- see
// WallJunction.angleDeg for the replacement). Still a GeometryNode subtype
// (nodeType stays "WALL" -- it only discriminates "this node is
// wall-shaped", true for every segment). `sequence` orders 0..N-1
// consecutive segments within one design; WallJunction rows connect
// consecutive segments. This pass enforces at most 2 segments / 1 junction
// at the APPLICATION layer only (MAX_WALL_SEGMENTS_PER_DESIGN,
// src/lib/graph/constants.ts) -- never a DB constraint -- so a future
// N-segment pass only needs to raise that constant, never a second
// migration for this shape.
model WallSegment {
  id       String       @id
  node     GeometryNode @relation(fields: [id], references: [id], onDelete: Cascade)
  designId String
  sequence Int
  lengthMm Float
  heightMm Float

  zones            Zone[]
  fixtures         Fixture[]
  productInstances ProductInstance[]
  junctionsAsA     WallJunction[]    @relation("JunctionSegmentA")
  junctionsAsB     WallJunction[]    @relation("JunctionSegmentB")

  @@unique([designId, sequence])
}

// A physical corner joining two consecutive WallSegments. Capped at exactly
// one per design this pass (see MAX_WALL_SEGMENTS_PER_DESIGN). angleDeg is a
// first-class typed field (not GeometryEdge.metadata Json) because it is
// meant to drive future trim/connector-selection rules by corner angle --
// unlike the removed Wall.cornerAngleDeg, there is no ~90-degree constraint:
// any physically real corner angle in the open interval (0, 360) is valid.
// No rendering geometry derives from this row this pass -- pure data plus a
// future extension point.
model WallJunction {
  id         String      @id @default(cuid())
  designId   String
  design     Design      @relation(fields: [designId], references: [id], onDelete: Cascade)
  segmentAId String
  segmentA   WallSegment @relation("JunctionSegmentA", fields: [segmentAId], references: [id], onDelete: Cascade)
  segmentBId String
  segmentB   WallSegment @relation("JunctionSegmentB", fields: [segmentBId], references: [id], onDelete: Cascade)
  angleDeg   Float
  createdAt  DateTime    @default(now())

  @@unique([segmentAId, segmentBId])
  @@index([designId])
}

enum ZoneAssociation {
  WALL
  STRUCTURE
}

model Zone {
  id              String          @id
  node            GeometryNode    @relation(fields: [id], references: [id], onDelete: Cascade)
  designId        String
  wallSegmentId   String?
  wallSegment     WallSegment?    @relation(fields: [wallSegmentId], references: [id])
  associatesWith  ZoneAssociation
  orderIndex      Int
  widthMm         Float
  heightMm        Float
  hasCoveLighting Boolean         @default(false)
  coveLightZMm    Float?

  partitions ZonePartition[]
}

model ZonePartition {
  id         String       @id
  node       GeometryNode @relation(fields: [id], references: [id], onDelete: Cascade)
  designId   String
  zoneId     String
  zone       Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orderIndex Int
  widthMm    Float
  heightMm   Float

  panels Panel[]
}

enum PanelOrientation {
  VERTICAL
  HORIZONTAL
}

model Panel {
  id             String           @id
  node           GeometryNode     @relation(fields: [id], references: [id], onDelete: Cascade)
  designId       String
  partitionId    String
  partition      ZonePartition    @relation(fields: [partitionId], references: [id], onDelete: Cascade)
  orderIndex     Int
  widthMm        Float
  heightMm       Float
  orientation    PanelOrientation
  isOffcut       Boolean          @default(false)
  offcutReusable Boolean?
}

enum GeometryEdgeRole {
  LEFT
  RIGHT
  TOP
  BOTTOM
  CORNER
  OUTER_BOUNDARY
  INNER_BOUNDARY
  PARTITION_EDGE
}

model GeometryEdge {
  id                  String           @id @default(cuid())
  designId            String
  design              Design           @relation(fields: [designId], references: [id], onDelete: Cascade)
  nodeId              String
  node                GeometryNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  edgeRole            GeometryEdgeRole
  requiresTermination Boolean          @default(false)
  requiresConnector   Boolean          @default(false)
  requiresTrim        Boolean          @default(false)
  isLightingBoundary  Boolean          @default(false)
  metadata            Json?

  edgeRelationshipsAsA                GeometryEdgeRelationship[]           @relation("EdgeA")
  edgeRelationshipsAsB                GeometryEdgeRelationship[]           @relation("EdgeB")
  geometryProductRelationships        GeometryProductRelationship[]
  templateParameters                  TemplateParameter[]
  projectGeometryProductRelationships ProjectGeometryProductRelationship[]
  constraintTargetsA                  Constraint[]                         @relation("ConstraintTargetAEdge")
  constraintTargetsB                  Constraint[]                         @relation("ConstraintTargetBEdge")

  @@index([designId, edgeRole])
  @@index([nodeId])
}

enum GeometryEdgeRelationshipType {
  ADJACENT_TO
  MEETS
  CONTINUES_TO
  SHARES_BOUNDARY
  TERMINATES_AT
}

// Models edge-to-edge relationships explicitly (e.g. Zone A's right boundary edge
// <-> Zone B's left boundary edge) instead of collapsing them into a generic
// node-to-node edge, so each side keeps its own independent semantics.
model GeometryEdgeRelationship {
  id               String                       @id @default(cuid())
  designId         String
  design           Design                       @relation(fields: [designId], references: [id], onDelete: Cascade)
  edgeAId          String
  edgeA            GeometryEdge                 @relation("EdgeA", fields: [edgeAId], references: [id], onDelete: Cascade)
  edgeBId          String
  edgeB            GeometryEdge                 @relation("EdgeB", fields: [edgeBId], references: [id], onDelete: Cascade)
  relationshipType GeometryEdgeRelationshipType

  @@index([designId])
  @@index([edgeAId])
  @@index([edgeBId])
}

// ---------------------------------------------------------------------------
// Product graph (SKU Master = catalog truth)
// ---------------------------------------------------------------------------

// Category is a first-class entity (not a bare enum) so the SKU Master's
// category vocabulary is dynamic catalog data, not a compile-time constant.
model Category {
  id    String @id @default(cuid())
  key   String @unique
  label String

  skus        SkuMaster[]
  skuVersions SkuMasterVersion[]
}

// Catalog/version history: SkuMaster is the live-editable catalog row;
// SkuMasterVersion (below) is an immutable snapshot taken whenever a
// physical/rule-affecting field changes (see PATCH /api/skus/[id]).
// currentVersion always points at the latest snapshot. MasterBomLine pins
// skuVersionId at BOM-generation time -- once a Template is published, its
// BOM's version pins never move even if the live SkuMaster keeps changing.
// Cosmetic fields (code, name) do NOT bump the version, matching "price
// changes don't republish" even though this schema has no per-SKU price
// field to exempt literally. Furniture option sub-tables
// (FurnitureDesignOption/ColourOption/SizeOption) are NOT versioned by this
// mechanism -- a deliberate scope line, not an oversight; see Phase 5 of
// the plan file for the full reconciliation this implements.
model SkuMaster {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  defaultWidthMm Float?
  defaultUnit    String    @default("EA")
  minCutPieceMm  Float?
  attributes     Json?
  // Whether a ProductInstance of this SKU may ever have its rotationDeg
  // changed from 0. Enforced server-side in updateProductInstance, not just
  // hidden in the UI -- a catalogue-driven furniture piece (e.g. a
  // wall-fixed unit) may simply not be an approved rotate target.
  rotatable      Boolean   @default(true)
  currentVersion Int       @default(1)
  // Set via POST /api/skus/[id]/discontinue. A discontinued SKU cannot be
  // placed as a NEW ProductInstance (see createProductInstance/
  // autoFillPartition), but every instance/BOM line that already references
  // it -- and its already-frozen SkuMasterVersion snapshots -- stay valid.
  discontinuedAt DateTime?

  edgesFrom               SkuEdge[]                @relation("SkuEdgeFrom")
  edgesTo                 SkuEdge[]                @relation("SkuEdgeTo")
  productInstances        ProductInstance[]
  designOptions           FurnitureDesignOption[]
  colourOptions           FurnitureColourOption[]
  sizeOptions             FurnitureSizeOption[]
  versions                SkuMasterVersion[]
  projectProductInstances ProjectProductInstance[]

  @@index([categoryId])
}

// An immutable snapshot of SkuMaster's physical/rule-affecting fields at one
// point in time. Created on every version bump (see PATCH /api/skus/[id]);
// never updated or deleted once created -- MasterBomLine rows referencing an
// old version must keep resolving correctly forever, even after the live
// SkuMaster has moved on to a newer version.
model SkuMasterVersion {
  id             String    @id @default(cuid())
  skuId          String
  sku            SkuMaster @relation(fields: [skuId], references: [id], onDelete: Cascade)
  version        Int
  code           String
  name           String
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  defaultWidthMm Float?
  defaultUnit    String
  minCutPieceMm  Float?
  attributes     Json?
  rotatable      Boolean
  createdAt      DateTime  @default(now())

  masterBomLines MasterBomLine[]
  finalBomLines  FinalBomLine[]

  @@unique([skuId, version])
}

// The Furniture Catalogue's selectable option groups. SKU-scoped (not a
// shared cross-SKU pool) because FurnitureSizeOption's dimensions are
// inherently per-product -- "Large" means something different on a sofa vs.
// a stool. Design/Colour are kept SKU-scoped too for the same simple,
// single-model shape; a shared swatch library is a clean future extension
// if ever needed, not required by the current catalogue-driven workflow.
model FurnitureDesignOption {
  id    String    @id @default(cuid())
  skuId String
  sku   SkuMaster @relation(fields: [skuId], references: [id], onDelete: Cascade)
  key   String
  label String

  instances        ProductInstance[]        @relation("InstanceDesignOption")
  projectInstances ProjectProductInstance[]

  @@unique([skuId, key])
}

model FurnitureColourOption {
  id          String    @id @default(cuid())
  skuId       String
  sku         SkuMaster @relation(fields: [skuId], references: [id], onDelete: Cascade)
  key         String
  label       String
  swatchColor String

  instances        ProductInstance[]        @relation("InstanceColourOption")
  projectInstances ProjectProductInstance[]

  @@unique([skuId, key])
}

// The one place fixed physical dimensions for a furniture configuration
// live. Never copied onto ProductInstance -- "SKU + Design + Colour + Size
// -> fixed configuration" stays a single source of truth, read live through
// the selection, not cached.
model FurnitureSizeOption {
  id       String    @id @default(cuid())
  skuId    String
  sku      SkuMaster @relation(fields: [skuId], references: [id], onDelete: Cascade)
  key      String
  label    String
  widthMm  Float
  depthMm  Float
  heightMm Float

  instances        ProductInstance[]        @relation("InstanceSizeOption")
  projectInstances ProjectProductInstance[]

  @@unique([skuId, key])
}

enum SkuEdgeType {
  REQUIRES
  CONNECTS_TO
  TERMINATES_WITH
  SUPPORTS
  COMPATIBLE_WITH
  INTERACTS_WITH
  INSTALLED_WITH
}

// Catalog-level truth: "PANEL-600 REQUIRES PVC-BACK-01". The Canvas only
// references these rows, it never redefines them.
model SkuEdge {
  id        String      @id @default(cuid())
  fromSkuId String
  fromSku   SkuMaster   @relation("SkuEdgeFrom", fields: [fromSkuId], references: [id], onDelete: Cascade)
  toSkuId   String
  toSku     SkuMaster   @relation("SkuEdgeTo", fields: [toSkuId], references: [id], onDelete: Cascade)
  edgeType  SkuEdgeType

  productInstanceEdges ProductInstanceEdge[]
  projectInstanceEdges ProjectProductInstanceEdge[]

  @@index([fromSkuId])
  @@index([toSkuId])
}

model ProductInstance {
  id             String        @id @default(cuid())
  designId       String
  design         Design        @relation(fields: [designId], references: [id], onDelete: Cascade)
  skuId          String
  sku            SkuMaster     @relation(fields: [skuId], references: [id])
  geometryNodeId String?
  geometryNode   GeometryNode? @relation(fields: [geometryNodeId], references: [id])
  // Which WallSegment's local mm frame x/y/z are measured in -- resolved at
  // creation time via resolveWallSegmentId (auto-defaulted to the design's
  // sole segment when unambiguous; required once 2 segments exist). Nullable
  // at the DB level (mirrors Zone.wallSegmentId's own convention).
  wallSegmentId  String?
  wallSegment    WallSegment?  @relation(fields: [wallSegmentId], references: [id])
  x              Float?
  y              Float?
  z              Float?
  rotationDeg    Float         @default(0)
  quantity       Float         @default(1)

  // The catalogue-selected configuration for a furniture placement (see
  // FurnitureDesignOption/FurnitureColourOption/FurnitureSizeOption above).
  // Null for non-furniture instances, or for a furniture SKU that defines no
  // options in that group.
  designOptionId String?
  designOption   FurnitureDesignOption? @relation("InstanceDesignOption", fields: [designOptionId], references: [id])
  colourOptionId String?
  colourOption   FurnitureColourOption? @relation("InstanceColourOption", fields: [colourOptionId], references: [id])
  sizeOptionId   String?
  sizeOption     FurnitureSizeOption?   @relation("InstanceSizeOption", fields: [sizeOptionId], references: [id])

  edgesFrom                    ProductInstanceEdge[]         @relation("InstanceEdgeFrom")
  edgesTo                      ProductInstanceEdge[]         @relation("InstanceEdgeTo")
  geometryProductRelationships GeometryProductRelationship[]
  masterBomLinesDirect         MasterBomLine[]               @relation("BomLineFromInstance")
  templateParameters           TemplateParameter[]
  projectInstances             ProjectProductInstance[]
  constraintTargetsA           Constraint[]                  @relation("ConstraintTargetAInstance")
  constraintTargetsB           Constraint[]                  @relation("ConstraintTargetBInstance")

  @@index([designId, skuId])
}

// Whether a design-graph relationship was created by explicit Designer action
// or by the Designer accepting a catalog-derived suggestion (see
// src/lib/suggestions.ts). Never set by silent/automatic creation -- every
// CATALOG_DERIVED row still traces back to an explicit "Add" click.
enum RelationshipOrigin {
  DESIGNER_DEFINED
  CATALOG_DERIVED
}

// The Designer's realization of a SkuEdge catalog rule for specific placed
// instances, e.g. "PanelInstance-17 requires BackSheetInstance-22", optionally
// pointing back at the SkuEdge it materializes via sourceSkuEdgeId.
model ProductInstanceEdge {
  id              String             @id @default(cuid())
  designId        String
  design          Design             @relation(fields: [designId], references: [id], onDelete: Cascade)
  fromInstanceId  String
  fromInstance    ProductInstance    @relation("InstanceEdgeFrom", fields: [fromInstanceId], references: [id], onDelete: Cascade)
  toInstanceId    String
  toInstance      ProductInstance    @relation("InstanceEdgeTo", fields: [toInstanceId], references: [id], onDelete: Cascade)
  edgeType        SkuEdgeType
  sourceSkuEdgeId String?
  sourceSkuEdge   SkuEdge?           @relation(fields: [sourceSkuEdgeId], references: [id])
  origin          RelationshipOrigin @default(DESIGNER_DEFINED)

  masterBomLines       MasterBomLine[]              @relation("BomLineFromInstanceEdge")
  projectInstanceEdges ProjectProductInstanceEdge[]

  @@index([designId])
  @@index([fromInstanceId])
  @@index([toInstanceId])
}

enum GeometryProductRelationshipType {
  HAS_TREATMENT
  SUPPORTS
  TERMINATES
  BOUNDARY_OF
  POSITIONED_AT
  ADJACENT_TO
}

// The join that connects a geometry fact to a product instance, e.g.
// "E17 --TERMINATES--> TrimInstance-42". Exactly one of geometryEdgeId /
// geometryNodeId is set (enforced at the API layer).
model GeometryProductRelationship {
  id                String                          @id @default(cuid())
  designId          String
  design            Design                          @relation(fields: [designId], references: [id], onDelete: Cascade)
  geometryEdgeId    String?
  geometryEdge      GeometryEdge?                   @relation(fields: [geometryEdgeId], references: [id], onDelete: Cascade)
  geometryNodeId    String?
  geometryNode      GeometryNode?                   @relation(fields: [geometryNodeId], references: [id], onDelete: Cascade)
  productInstanceId String
  productInstance   ProductInstance                 @relation(fields: [productInstanceId], references: [id], onDelete: Cascade)
  relationshipType  GeometryProductRelationshipType
  // Documentation-only this pass: stored/displayed, not interpreted by any
  // algorithm. A future Consultant/Physical Engine/Resolver can evaluate it.
  condition         Json?
  // { "type": "FIXED", "value": n } | { "type": "PER_LENGTH_MM", "perMm": n } | null.
  // Drives resolveQuantity() in bom.ts; null falls back to productInstance.quantity.
  quantityRule      Json?
  origin            RelationshipOrigin              @default(DESIGNER_DEFINED)

  masterBomLines                      MasterBomLine[]                      @relation("BomLineFromRelationship")
  projectGeometryProductRelationships ProjectGeometryProductRelationship[]

  @@index([designId])
  @@index([geometryEdgeId])
  @@index([geometryNodeId])
  @@index([productInstanceId])
}

// ---------------------------------------------------------------------------
// Consultant permissions
// ---------------------------------------------------------------------------

enum ParameterType {
  NUMERIC_RANGE
  ENUM_SELECTION
  POSITION
  SKU_SUBSTITUTION
  EDGE_TREATMENT
  QUANTITY
}

model TemplateParameter {
  id                      String           @id @default(cuid())
  templateId              String
  template                Design           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  targetProductInstanceId String?
  targetProductInstance   ProductInstance? @relation(fields: [targetProductInstanceId], references: [id], onDelete: Cascade)
  targetGeometryEdgeId    String?
  targetGeometryEdge      GeometryEdge?    @relation(fields: [targetGeometryEdgeId], references: [id], onDelete: Cascade)
  paramKey                String
  paramType               ParameterType
  label                   String
  defaultValue            String
  unit                    String?

  permission ConsultantPermission?

  @@index([templateId])
}

model ConsultantPermission {
  id                   String            @id @default(cuid())
  templateParameterId  String            @unique
  templateParameter    TemplateParameter @relation(fields: [templateParameterId], references: [id], onDelete: Cascade)
  editableByConsultant Boolean           @default(false)
  minValue             Float?
  maxValue             Float?
  allowedValues        String[]          @default([])
}

// ---------------------------------------------------------------------------
// Master BOM
// ---------------------------------------------------------------------------

model MasterBom {
  id          String   @id @default(cuid())
  templateId  String
  template    Design   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  generatedAt DateTime @default(now())

  lines MasterBomLine[]

  @@index([templateId])
}

model MasterBomLine {
  id            String            @id @default(cuid())
  masterBomId   String
  masterBom     MasterBom         @relation(fields: [masterBomId], references: [id], onDelete: Cascade)
  skuId         String
  quantity      Float
  unitOfMeasure String
  // Pinned to the SKU's currentVersion at the moment this line was
  // generated (see generateMasterBom in src/lib/graph/bom.ts). Nullable
  // only because lines generated before this field existed have none --
  // every line generated from now on gets one.
  skuVersionId  String?
  skuVersion    SkuMasterVersion? @relation(fields: [skuVersionId], references: [id])

  sourceGeometryProductRelationshipId String?
  sourceGeometryProductRelationship   GeometryProductRelationship? @relation("BomLineFromRelationship", fields: [sourceGeometryProductRelationshipId], references: [id], onDelete: Cascade)
  sourceProductInstanceEdgeId         String?
  sourceProductInstanceEdge           ProductInstanceEdge?         @relation("BomLineFromInstanceEdge", fields: [sourceProductInstanceEdgeId], references: [id], onDelete: Cascade)
  sourceProductInstanceId             String?
  sourceProductInstance               ProductInstance?             @relation("BomLineFromInstance", fields: [sourceProductInstanceId], references: [id], onDelete: Cascade)

  @@index([masterBomId])
  @@index([skuId])
}

// ---------------------------------------------------------------------------
// Consultant Project State (snapshot of a published Template's product graph)
// ---------------------------------------------------------------------------

// A Consultant's working instance of a published Template. No lifecycle/
// status field this pass -- edits are always allowed, subject to the
// bounds-check in src/lib/graph/project.ts; a future "lock once ordered"
// status is a natural, deferred extension.
model Project {
  id              String   @id @default(cuid())
  name            String
  templateId      String
  template        Design   @relation(fields: [templateId], references: [id])
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productInstances             ProjectProductInstance[]
  productInstanceEdges         ProjectProductInstanceEdge[]
  geometryProductRelationships ProjectGeometryProductRelationship[]
  finalBoms                    FinalBom[]

  @@index([templateId])
  @@index([createdByUserId])
}

// Snapshot-copied from ProductInstance at Project creation. geometryNodeId
// is a direct FK into the TEMPLATE's own frozen GeometryNode -- never
// copied/remapped, since the geometry graph never changes once published.
// sourceProductInstanceId is nullable -- null only for a Project-only
// instance synthesized by the EDGE_TREATMENT swap mutator
// (setProjectEdgeTreatment), which has no Template origin and is therefore
// never itself further bounded-editable ("chained substitution" -- see the
// plan file's Phase 5 item 4 section).
model ProjectProductInstance {
  id                      String           @id @default(cuid())
  projectId               String
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceProductInstanceId String?
  sourceProductInstance   ProductInstance? @relation(fields: [sourceProductInstanceId], references: [id])
  skuId                   String
  sku                     SkuMaster        @relation(fields: [skuId], references: [id])
  geometryNodeId          String?
  geometryNode            GeometryNode?    @relation(fields: [geometryNodeId], references: [id])
  x                       Float?
  y                       Float?
  z                       Float?
  rotationDeg             Float            @default(0)
  quantity                Float            @default(1)

  designOptionId String?
  designOption   FurnitureDesignOption? @relation(fields: [designOptionId], references: [id])
  colourOptionId String?
  colourOption   FurnitureColourOption? @relation(fields: [colourOptionId], references: [id])
  sizeOptionId   String?
  sizeOption     FurnitureSizeOption?   @relation(fields: [sizeOptionId], references: [id])

  edgesFrom                    ProjectProductInstanceEdge[]         @relation("ProjectInstanceEdgeFrom")
  edgesTo                      ProjectProductInstanceEdge[]         @relation("ProjectInstanceEdgeTo")
  geometryProductRelationships ProjectGeometryProductRelationship[]
  finalBomLinesDirect          FinalBomLine[]                       @relation("FinalBomLineFromInstance")

  @@index([projectId, skuId])
  @@index([sourceProductInstanceId])
}

// Snapshot-copied from ProductInstanceEdge -- always traces back to exactly
// one Template edge (sourceProductInstanceEdgeId is required: this pass
// never lets a Consultant create a brand-new product-instance edge).
model ProjectProductInstanceEdge {
  id                          String                 @id @default(cuid())
  projectId                   String
  project                     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceProductInstanceEdgeId String
  sourceProductInstanceEdge   ProductInstanceEdge    @relation(fields: [sourceProductInstanceEdgeId], references: [id])
  fromInstanceId              String
  fromInstance                ProjectProductInstance @relation("ProjectInstanceEdgeFrom", fields: [fromInstanceId], references: [id], onDelete: Cascade)
  toInstanceId                String
  toInstance                  ProjectProductInstance @relation("ProjectInstanceEdgeTo", fields: [toInstanceId], references: [id], onDelete: Cascade)
  edgeType                    SkuEdgeType
  sourceSkuEdgeId             String?
  sourceSkuEdge               SkuEdge?               @relation(fields: [sourceSkuEdgeId], references: [id])

  finalBomLines FinalBomLine[] @relation("FinalBomLineFromInstanceEdge")

  @@index([projectId])
  @@index([fromInstanceId])
  @@index([toInstanceId])
}

// Snapshot-copied from GeometryProductRelationship. geometryEdgeId /
// geometryNodeId are direct FKs into the TEMPLATE's frozen rows (never
// copied); productInstanceId points at a ProjectProductInstance.
// sourceGeometryProductRelationshipId is required -- this pass only ever
// UPDATES an existing row's productInstanceId (see setProjectEdgeTreatment),
// it never creates a brand-new relationship.
model ProjectGeometryProductRelationship {
  id                                  String                          @id @default(cuid())
  projectId                           String
  project                             Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceGeometryProductRelationshipId String
  sourceGeometryProductRelationship   GeometryProductRelationship     @relation(fields: [sourceGeometryProductRelationshipId], references: [id])
  geometryEdgeId                      String?
  geometryEdge                        GeometryEdge?                   @relation(fields: [geometryEdgeId], references: [id])
  geometryNodeId                      String?
  geometryNode                        GeometryNode?                   @relation(fields: [geometryNodeId], references: [id])
  productInstanceId                   String
  productInstance                     ProjectProductInstance          @relation(fields: [productInstanceId], references: [id], onDelete: Cascade)
  relationshipType                    GeometryProductRelationshipType
  condition                           Json?
  quantityRule                        Json?

  finalBomLines FinalBomLine[] @relation("FinalBomLineFromRelationship")

  @@index([projectId])
  @@index([geometryEdgeId])
  @@index([geometryNodeId])
  @@index([productInstanceId])
}

// ---------------------------------------------------------------------------
// Final BOM (BOM Resolver output) -- Project-scoped, structurally identical
// discipline to MasterBom/MasterBomLine but never touches those tables.
// ---------------------------------------------------------------------------

model FinalBom {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  generatedAt DateTime @default(now())

  lines FinalBomLine[]

  @@index([projectId])
}

model FinalBomLine {
  id            String            @id @default(cuid())
  finalBomId    String
  finalBom      FinalBom          @relation(fields: [finalBomId], references: [id], onDelete: Cascade)
  skuId         String
  quantity      Float
  unitOfMeasure String
  skuVersionId  String?
  skuVersion    SkuMasterVersion? @relation(fields: [skuVersionId], references: [id])

  sourceProjectGeometryProductRelationshipId String?
  sourceProjectGeometryProductRelationship   ProjectGeometryProductRelationship? @relation("FinalBomLineFromRelationship", fields: [sourceProjectGeometryProductRelationshipId], references: [id], onDelete: Cascade)
  sourceProjectProductInstanceEdgeId         String?
  sourceProjectProductInstanceEdge           ProjectProductInstanceEdge?         @relation("FinalBomLineFromInstanceEdge", fields: [sourceProjectProductInstanceEdgeId], references: [id], onDelete: Cascade)
  sourceProjectProductInstanceId             String?
  sourceProjectProductInstance               ProjectProductInstance?             @relation("FinalBomLineFromInstance", fields: [sourceProjectProductInstanceId], references: [id], onDelete: Cascade)

  @@index([finalBomId])
  @@index([skuId])
}

// ---------------------------------------------------------------------------
// Fixture (customer/site elements -- never enter the BOM)
// ---------------------------------------------------------------------------

enum FixtureType {
  TV
  AC_UNIT
  ELECTRICAL_SOCKET
  WINDOW
  DOOR
}

// A customer/site element (TV, AC unit, socket, window, door) that exists in
// the physical space a Template will be installed into. Drives
// placement/clearance constraints (validation rule 18,
// FIXTURE_CLEARANCE_OVERLAP) but is a site fact, not a manufactured or
// purchased item -- it must NEVER appear in the Master BOM. This is
// structural, not filtered: Fixture has no FK into ProductInstance,
// GeometryProductRelationship, or ProductInstanceEdge, and
// computeMasterBomLines has no fourth provenance source to find one through
// even if it wanted to.
//
// xMm/yMm are the TOP-LEFT corner of the fixture's bounding box (matching
// Wall/Zone/Partition/Panel's own left-edge convention) -- NOT
// ProductInstance's center-anchor convention (see FurnitureLayer.tsx's Konva
// offsetX/offsetY). Both live in the same wall-elevation mm plane as every
// other geometry entity ((0,0) at the wall's top-left); no depth/z axis is
// modeled.
model Fixture {
  id            String       @id @default(cuid())
  designId      String
  design        Design       @relation(fields: [designId], references: [id], onDelete: Cascade)
  fixtureType   FixtureType
  label         String?
  // Which WallSegment's local mm frame xMm/yMm are measured in -- resolved
  // at creation time via resolveWallSegmentId (see ProductInstance's own
  // identical field for the same rationale).
  wallSegmentId String?
  wallSegment   WallSegment? @relation(fields: [wallSegmentId], references: [id])
  xMm           Float
  yMm           Float
  widthMm       Float
  heightMm      Float
  // Required clearance beyond the fixture's own box, in mm, applied
  // uniformly on all four sides. Defaults to 0 -- "no clearance
  // requirement" until the Designer explicitly sets one.
  clearanceMm   Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  constraintTargetsA Constraint[] @relation("ConstraintTargetAFixture")
  constraintTargetsB Constraint[] @relation("ConstraintTargetBFixture")

  @@index([designId])
  @@index([wallSegmentId])
}

// ---------------------------------------------------------------------------
// Constraint graph (validation-only -- see src/lib/graph/constraint.ts).
// ---------------------------------------------------------------------------

enum ConstraintTargetKind {
  FIXTURE
  PRODUCT_INSTANCE
  GEOMETRY_NODE
  GEOMETRY_EDGE
}

enum ConstraintAxis {
  X
  Y
}

// DISTANCE/ALIGN/MIN_MAX/CENTER/EDGE_TO_EDGE/FIXED_POSITION are positional;
// EQUAL reuses this same axis field to mean "which dimension" (X ->
// widthMm, Y -> heightMm) rather than adding a second near-duplicate field
// -- see src/lib/graph/constraint.ts for exact per-type semantics.
// PARALLEL/PERPENDICULAR are NOT modeled -- Fixture has no rotation field
// at all, and ProductInstance.rotationDeg is only real for sku.rotatable
// SKUs; a type that only half-covers the eligible endpoint kinds is
// deliberately not built.
enum ConstraintType {
  DISTANCE
  ALIGN
  EQUAL
  MIN_MAX
  CENTER
  EDGE_TO_EDGE
  FIXED_POSITION
}

// A stored, declarative spatial fact between two freestanding entities (or
// one freestanding entity and a fixed WALL-typed GeometryNode/GeometryEdge
// anchor) -- see validation rule 20 (CONSTRAINT_SATISFIED), the ONLY thing
// that ever reads this table. NEVER written to by any solver/auto-repair
// logic -- "+ Solver" is explicitly out of scope this pass; a Constraint
// row is a pure assertion, exactly like PARTITION_COVERAGE/PANEL_COVERAGE's
// own after-the-fact mismatch reporting, never geometry that gets adjusted.
//
// Each endpoint is exactly one of Fixture / ProductInstance / a WALL-typed
// GeometryNode / that WallSegment's own LEFT|RIGHT|TOP|BOTTOM boundary
// GeometryEdge, enforced at the application layer (assertValidShape in
// src/lib/graph/constraint.ts). GeometryNode/GeometryEdge targets are
// scoped to WALL only -- Zone/Partition/Panel positions are DERIVED
// (computeZoneLayout), never stored, and resolving them here would pull
// that pure layout function into validation.ts, a coupling this pass does
// not take on silently.
//
// targetB* columns are all null for the single-target FIXED_POSITION type;
// required for every other ConstraintType.
model Constraint {
  id             String         @id @default(cuid())
  designId       String
  design         Design         @relation(fields: [designId], references: [id], onDelete: Cascade)
  constraintType ConstraintType

  targetAKind              ConstraintTargetKind
  targetAFixtureId         String?
  targetAFixture           Fixture?             @relation("ConstraintTargetAFixture", fields: [targetAFixtureId], references: [id], onDelete: Cascade)
  targetAProductInstanceId String?
  targetAProductInstance   ProductInstance?     @relation("ConstraintTargetAInstance", fields: [targetAProductInstanceId], references: [id], onDelete: Cascade)
  targetAGeometryNodeId    String?
  targetAGeometryNode      GeometryNode?        @relation("ConstraintTargetANode", fields: [targetAGeometryNodeId], references: [id], onDelete: Cascade)
  targetAGeometryEdgeId    String?
  targetAGeometryEdge      GeometryEdge?        @relation("ConstraintTargetAEdge", fields: [targetAGeometryEdgeId], references: [id], onDelete: Cascade)

  targetBKind              ConstraintTargetKind?
  targetBFixtureId         String?
  targetBFixture           Fixture?              @relation("ConstraintTargetBFixture", fields: [targetBFixtureId], references: [id], onDelete: Cascade)
  targetBProductInstanceId String?
  targetBProductInstance   ProductInstance?      @relation("ConstraintTargetBInstance", fields: [targetBProductInstanceId], references: [id], onDelete: Cascade)
  targetBGeometryNodeId    String?
  targetBGeometryNode      GeometryNode?         @relation("ConstraintTargetBNode", fields: [targetBGeometryNodeId], references: [id], onDelete: Cascade)
  targetBGeometryEdgeId    String?
  targetBGeometryEdge      GeometryEdge?         @relation("ConstraintTargetBEdge", fields: [targetBGeometryEdgeId], references: [id], onDelete: Cascade)

  axis       ConstraintAxis
  // DISTANCE/EDGE_TO_EDGE/FIXED_POSITION's target value; null otherwise.
  valueMm    Float?
  // MIN_MAX's range; both null otherwise.
  minValueMm Float?
  maxValueMm Float?
  createdAt  DateTime       @default(now())

  @@index([designId])
}
